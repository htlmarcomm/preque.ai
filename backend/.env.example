# Vision AI — GitHub Models (free GPT-4o, 50 req/day)
# Get token: github.com → Settings → Developer settings → Personal access tokens → Generate new token (classic)
OPENAI_API_KEY=ghp_your_github_token_here

# Cerebras — fast text fill matching (free)
# Get key: cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_key_here

# Database
DATABASE_URL=sqlite:///./preque.db

# Optional: only if LibreOffice is not in default location
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Only needed if using SharePoint export/import (routers/sharepoint.py)
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
