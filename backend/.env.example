# Vision AI — Google Gemini via its OpenAI-compatible endpoint (free tier,
# 1,500 req/day, no card required). GitHub Models (the original provider
# here) was permanently retired 2026-07-30 -- this key is read the same way
# via the openai SDK, just pointed at a different base_url (see
# backend/routers/forms.py).
# Get a key: aistudio.google.com/apikey
OPENAI_API_KEY=your_gemini_key_here

# Cerebras — fast text fill matching (free, currently unused by any active
# code path)
# Get key: cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_key_here

# Database
DATABASE_URL=sqlite:///./preque.db

# Shared secret every /api/* request must send as the X-API-Key header (see
# backend/auth.py). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match VITE_API_KEY in frontend/.env.
API_ACCESS_KEY=

# Optional: only if LibreOffice is not in default location
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Only needed if using SharePoint export/import (routers/sharepoint.py)
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
